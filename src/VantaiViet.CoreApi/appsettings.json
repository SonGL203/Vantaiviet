{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Notifications": {
    "WorkerEnabled": true,
    "Simulate": true,
    "MaxRequestsPerHour": 100
  },
  "Maps": {
    "RoutingBaseUrl": "https://router.project-osrm.org/"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
